generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model WatchlistItem {
  id            String   @id @default(cuid())
  userId        String
  mediaId       Int
  mediaType     MediaType
  title         String
  posterPath    String?
  backdropPath  String?
  releaseDate   String?
  createdAt     DateTime @default(now())

  @@unique([userId, mediaId, mediaType])
}

enum MediaType {
  movie
  tv
}
